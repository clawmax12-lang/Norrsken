# Permanent server-side credential. Never expose this as NEXT_PUBLIC_*.
GEMINI_API_KEY=replace_with_ai_studio_key

# Required by later planning, viewer-panel and explanation stages.
CONDENSE_API_KEY=replace_with_condense_key
TRIBE_ENDPOINT=https://replace-with-tribe-worker.example

# Brain companion (FR-12/FR-14): public base URL of the Preflight FastAPI backend for the
# read-only activity stream and results. Not a secret; leave empty to keep the dock idle.
NEXT_PUBLIC_PREFLIGHT_API_BASE=
