# Copy to .env. Never commit real values.
# Permanent server-side credential. Never expose this as NEXT_PUBLIC_*.
GOOGLE_API_KEY=replace_with_ai_studio_key
# Backwards-compatible fallback if existing environments already use it.
GEMINI_API_KEY=

# Optional URL for the FastAPI orchestrator. Unset keeps Run in an honest unavailable state.
PREFLIGHT_API_URL=
# Public browser-visible URL for the same orchestrator, used only after a backend project is accepted.
NEXT_PUBLIC_PREFLIGHT_API_BASE=

# Routes the viewer panel and explanations through Condense and measures token savings.
CONDENSE_API_KEY=replace_with_condense_key

# Base URL of our deployed TRIBE GPU worker (not a Meta API). Unset = "Brain sim off".
# TRIBE_ENDPOINT=http://your-gpu-worker:8080

# Backend storage and generation settings (DATA_DIR defaults to <repo>/data/projects)
MAX_VARIANTS=3
MAX_REVISIONS=1
