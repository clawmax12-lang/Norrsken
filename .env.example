# Copy to .env. Never commit real values.
# Permanent server-side credential. Never expose this as NEXT_PUBLIC_*.
GOOGLE_API_KEY=replace_with_ai_studio_key
# Backwards-compatible fallback if existing environments already use it.
GEMINI_API_KEY=
# Existing Vercel projects may use this lowercase server-only alias.
google=

# Optional URL for the FastAPI orchestrator. Unset keeps Run in an honest unavailable state.
PREFLIGHT_API_URL=
# Public browser-visible URL for the same orchestrator, used only after a backend project is accepted.
# Set to /preflight-api to go through this Next server's proxy to PREFLIGHT_API_URL (one origin, no CORS).
# Both are read at build time: rebuild after changing them.
NEXT_PUBLIC_PREFLIGHT_API_BASE=

# Routes the viewer panel and explanations through Condense and measures token savings.
CONDENSE_API_KEY=replace_with_condense_key

# Runtime final-video composition. Set these on the Python/FastAPI renderer host.
# A key stored only in Vercel is NOT forwarded to the separately hosted backend.
# Never use NEXT_PUBLIC_ for either permanent provider key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPUS_MAX_OUTPUT_TOKENS=4096

# Base URL of our deployed TRIBE GPU worker (not a Meta API). Unset = "Brain sim off".
# TRIBE_ENDPOINT=http://your-gpu-worker:8080

# Backend storage and generation settings (DATA_DIR defaults to <repo>/data/projects)
MAX_VARIANTS=3
MAX_REVISIONS=1

# Sound for the exported videos: narration (Gemini text-to-speech), music and effects, mixed with ffmpeg.
# SOUND_ENABLED=true
# NARRATION_ENABLED=true
# TTS_MODEL=gemini-3.8-flash-tts
# NARRATION_VOICE=Leda
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe
