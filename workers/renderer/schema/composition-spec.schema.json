{
  "$defs": {
    "AssetKind": {
      "description": "Generated supporting asset type.",
      "enum": [
        "image",
        "video"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "Beat": {
      "additionalProperties": false,
      "description": "One timed event: what happens, from which frame, for how long, in which scene.\n\n``point`` is where a tap lands, as ``(x, y)`` 0-1 of the scene's screen (its crop when set).",
      "properties": {
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "frames": {
          "minimum": 1,
          "title": "Frames",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/BeatKind"
        },
        "point": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point"
        },
        "scene": {
          "minimum": 0,
          "title": "Scene",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "frame",
        "frames",
        "scene"
      ],
      "title": "Beat",
      "type": "object"
    },
    "BeatKind": {
      "description": "A moment the picture marks and the soundtrack hits on the same frame.",
      "enum": [
        "hook",
        "move",
        "word",
        "count",
        "tap",
        "punch",
        "cta"
      ],
      "title": "BeatKind",
      "type": "string"
    },
    "BriefField": {
      "description": "Brief fields that on-screen copy may be sourced from (``source_field``).",
      "enum": [
        "product_name",
        "one_liner",
        "goal_note",
        "audience",
        "buyer_cta",
        "proof_points"
      ],
      "title": "BriefField",
      "type": "string"
    },
    "GeneratedAsset": {
      "additionalProperties": false,
      "description": "A generated background or b-roll clip with provenance. Never contains product UI or text.",
      "properties": {
        "duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "model",
        "prompt",
        "sha256"
      ],
      "title": "GeneratedAsset",
      "type": "object"
    },
    "Layout": {
      "description": "Where the real screenshot sits relative to the headline.",
      "enum": [
        "device_center",
        "device_float",
        "text_only"
      ],
      "title": "Layout",
      "type": "string"
    },
    "SceneSpec": {
      "additionalProperties": false,
      "description": "One scene in frames, with its copy, real screenshot and optional generated backdrop.",
      "properties": {
        "backdrop": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratedAsset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "crop": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Device display inside a mockup; focus is relative to it.",
          "title": "Crop"
        },
        "emphasis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emphasis"
        },
        "end_frame": {
          "exclusiveMinimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "focus": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focus"
        },
        "layout": {
          "$ref": "#/$defs/Layout"
        },
        "screenshot": {
          "minLength": 1,
          "title": "Screenshot",
          "type": "string"
        },
        "shot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Shot"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Camera framing; the renderer falls back when a source is small."
        },
        "source_field": {
          "$ref": "#/$defs/BriefField"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "text_frames": {
          "default": [],
          "description": "Frame each word of text lands on, following the narrator; empty: own pace.",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Text Frames",
          "type": "array"
        },
        "transition_in": {
          "$ref": "#/$defs/Transition"
        },
        "voice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "text",
        "source_field",
        "screenshot",
        "layout",
        "transition_in"
      ],
      "title": "SceneSpec",
      "type": "object"
    },
    "Shot": {
      "description": "How the camera frames a scene's screen; the renderer falls back when a source is small.",
      "enum": [
        "hero",
        "close_up",
        "takeover",
        "tilt"
      ],
      "title": "Shot",
      "type": "string"
    },
    "Theme": {
      "additionalProperties": false,
      "description": "Visual tokens for one video. Typography follows the template's design system.",
      "properties": {
        "accent": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Accent",
          "type": "string"
        },
        "background": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background",
          "type": "string"
        },
        "font_family": {
          "minLength": 1,
          "title": "Font Family",
          "type": "string"
        },
        "foreground": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Foreground",
          "type": "string"
        }
      },
      "required": [
        "background",
        "foreground",
        "accent",
        "font_family"
      ],
      "title": "Theme",
      "type": "object"
    },
    "Transition": {
      "description": "How a scene enters.",
      "enum": [
        "cut",
        "fade",
        "push",
        "scale"
      ],
      "title": "Transition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Everything Remotion needs to render one 1080x1920, 30 fps, 15 s variant.",
  "properties": {
    "beats": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Beat"
      },
      "title": "Beats",
      "type": "array"
    },
    "chips": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Chips",
      "type": "array"
    },
    "cta": {
      "minLength": 1,
      "title": "Cta",
      "type": "string"
    },
    "cta_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cta Hint"
    },
    "cta_source_field": {
      "$ref": "#/$defs/BriefField"
    },
    "duration_frames": {
      "exclusiveMinimum": 0,
      "title": "Duration Frames",
      "type": "integer"
    },
    "end_voice": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Voice"
    },
    "fps": {
      "default": 30,
      "maximum": 30,
      "minimum": 30,
      "title": "Fps",
      "type": "integer"
    },
    "headline": {
      "minLength": 1,
      "title": "Headline",
      "type": "string"
    },
    "headline_source_field": {
      "$ref": "#/$defs/BriefField"
    },
    "height": {
      "default": 1920,
      "maximum": 1920,
      "minimum": 1920,
      "title": "Height",
      "type": "integer"
    },
    "logo": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logo"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/SceneSpec"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "theme": {
      "$ref": "#/$defs/Theme"
    },
    "variant_id": {
      "pattern": "^[A-Z]$",
      "title": "Variant Id",
      "type": "string"
    },
    "width": {
      "default": 1080,
      "maximum": 1080,
      "minimum": 1080,
      "title": "Width",
      "type": "integer"
    },
    "wordmark": {
      "minLength": 1,
      "title": "Wordmark",
      "type": "string"
    }
  },
  "required": [
    "variant_id",
    "duration_frames",
    "theme",
    "scenes",
    "cta",
    "cta_source_field",
    "wordmark",
    "headline",
    "headline_source_field"
  ],
  "title": "CompositionSpec",
  "type": "object"
}
